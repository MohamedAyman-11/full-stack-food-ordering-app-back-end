generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  email               String               @unique
  provider            AuthProvider         @default(LOCAL)
  password            String?
  role                Role                 @default(CUSTOMER)
  picture             Json?
  googleId            String?              @unique
  primaryPhone        String?
  secondaryPhone      String?
  city                String?
  country             String?
  street              String?
  postalCode          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ordersAsCustomer    Order[]              @relation("Ordering")
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  image         Json
  price         Decimal
  discount      Decimal?       @default(0)
  description   String
  isAvailable   Boolean        @default(true)
  categoryId    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productExtras ProductExtra[]
  productSizes  ProductSize[]
}

model Size {
  id          String        @id @default(uuid())
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  productSize ProductSize[]
  orderItems  OrderItem[]
}

model ProductSize {
  sizeId    String
  productId String
  price     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size     @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([sizeId, productId])
}

model Extra {
  id              String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productExtras   ProductExtra[]
  orderItemExtras OrderItemExtra[]
}

model ProductExtra {
  extraId   String
  productId String
  price     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  extra     Extra    @relation(fields: [extraId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([extraId, productId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  image     Json
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Order {
  id               String        @id @default(uuid())
  totalPrice       Decimal
  discount         Decimal?
  customerPhone    String
  taxes            Decimal?
  subtotal         Decimal
  deliveryFee      Decimal?
  city             String
  country          String
  street           String
  postalCode       String
  userId           String
  code             String
  placedAt         DateTime?
  assignedAt       DateTime?
  confirmedAt      DateTime?
  packedAt         DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  deliveryOtp      Int?
  orderStatus      OrderStatus   @default(PLACED)
  paymentMethod    PaymentMethod
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation("Ordering", fields: [userId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  payment          Payment?
  deliveryBoy      DeliveryBoy?  @relation(fields: [deliveryBoyId], references: [id])
  deliveryBoyId    String?
}

model OrderItem {
  orderId         String
  productId       String
  sizeId          String
  quantity        Int
  discount        Decimal
  totalPrice      Decimal
  unitPrice       Decimal
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItemId     String           @id @default(uuid())
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id])
  size            Size             @relation(fields: [sizeId], references: [id])
  orderItemExtras OrderItemExtra[]
}

model OrderItemExtra {
  extraId     String
  orderItemId String
  price       Decimal
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  extra       Extra     @relation(fields: [extraId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade)

  @@id([extraId, orderItemId])
}

model DeliveryBoy {
  id        String            @id @default(uuid())
  phone     String            @unique
  email     String            @unique
  name      String
  password  String
  status    DeliveryBoyStatus @default(ACTIVE)
  vehicle   Delivery_Vehicle  @default(BIKE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  orders    Order[]
}

model Payment {
  id     String  @id @default(uuid())
  amount Decimal

  status PaymentStatus @default(UNPAID)

  orderId String @unique

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  ASSIGNED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PENDING_PAYMENT
}

enum PaymentMethod {
  CREDIT
  ON_DELIVERY
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY
}

enum Delivery_Vehicle {
  BIKE
  SCOOTER
  CAR
}

enum DeliveryBoyStatus {
  ACTIVE
  INACTIVE
}

enum AuthProvider {
  GOOGLE
  LOCAL
}
